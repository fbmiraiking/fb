[Unit]
Description=Standard Lens API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/standard-lens/backend
# Keep one worker: the in-process APScheduler and the sync task lock assume a
# single API process. For multiple workers, run a separate scheduler process.
ExecStart=/opt/standard-lens/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
