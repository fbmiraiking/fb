# ============================================================
# Standard Lens backend configuration
# Copy this file to backend/.env and adjust the values.
# Never commit the real .env file.
# ============================================================

# ---------- Application ----------
APP_NAME=Standard Lens API
APP_ENV=development
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma separated list of allowed origins.
# The Vite dev server runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- MySQL 8 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=standard_lens
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=standard_lens
MYSQL_CHARSET=utf8mb4

# Optional: a full SQLAlchemy URL overrides all MYSQL_* values above.
# DATABASE_URL=mysql+pymysql://standard_lens:change_me@127.0.0.1:3306/standard_lens?charset=utf8mb4

# ---------- Connection pool ----------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_CONNECT_TIMEOUT=3

# ---------- Admin / standard sync ----------
# Required by POST /api/admin/sync/standards. Change it before enabling the endpoint.
ADMIN_SYNC_TOKEN=change_me_admin_token
SYNC_SOURCE=std_samr
SYNC_SCHEDULER_ENABLED=true
SYNC_RECOVER_STALE_TASKS=true
SYNC_SCHEDULE_HOUR=2
SYNC_SCHEDULE_MINUTE=0
SYNC_REQUEST_INTERVAL_SECONDS=1.0
SYNC_TIMEOUT_SECONDS=20
SYNC_MAX_RETRIES=3
SYNC_RETRY_BACKOFF_SECONDS=1.0
SYNC_PAGE_SIZE=50
# 0 = unlimited. The first full initialization is triggered via the admin API;
# set a small value here if you want a trial run instead of the whole catalog.
SYNC_MAX_ITEMS_PER_RUN=0
SYNC_UPDATE_MAX_PAGES=20
SYNC_OVERLAP_HOURS=24
SYNC_USER_AGENT=StandardLens/0.4

# ---------- User AI ----------
# User API keys are sent per request by the browser and are never stored here.
AI_REQUEST_TIMEOUT_SECONDS=20

# ---------- Standards CSV bootstrap ----------
# On first startup, if the standard table is empty, import backend/data/standards.csv.
STANDARDS_CSV_BOOTSTRAP_ENABLED=true
# Optional absolute path, or a path relative to the backend directory:
# STANDARDS_CSV_PATH=data/standards.csv
